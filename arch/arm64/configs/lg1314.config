# LG1314 (LJ9 / OLED55B9PLA) overlay on top of a distro arm64 config.
#   scripts/kconfig/merge_config.sh -m <distro config> arch/arm64/configs/lg1314.config
#   make ARCH=arm64 olddefconfig

# --- SoC + port drivers (built in, as in the dev config) ---
CONFIG_ARCH_LG1K=y
CONFIG_CLK_LG1K=y
CONFIG_PINCTRL_LG1314=y
CONFIG_I2C_LG1314=y
CONFIG_PHY_LG1314_USB=y
CONFIG_LG1314_THERMAL=y
CONFIG_DRM=y
CONFIG_DRM_LG1314=y
CONFIG_ARM_SP805_WATCHDOG=y
CONFIG_MFD_LG1314_MICOM=y
CONFIG_RTC_DRV_LG1314_MICOM=y
CONFIG_INPUT_LG1314_MICOM_PWRKEY=y
# On-board MT7668 Wi-Fi (USB); firmware from the stock image, see provisioning
CONFIG_MT7668U=m
# ...and its Bluetooth (btusb MediaTek setup: ROM patch download)
CONFIG_BT_HCIBTUSB_MTK=y
# Early console on the OSD scanout lxboot leaves live (DT simple-framebuffer)
CONFIG_DRM_SIMPLEDRM=y

# DE firmware built into the image (temporary hack, see cfw/mainline.md)
CONFIG_EXTRA_FIRMWARE="lg1314/de_fw.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

# --- No initramfs: root mount path (ext4 on eMMC) built in ---
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_LG1K=y
CONFIG_LG1314_VDEC=m
