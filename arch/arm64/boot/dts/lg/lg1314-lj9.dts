// SPDX-License-Identifier: GPL-2.0
/*
 * Derived from a "LJ9 Chassis" board found in an LG OLED55B9PLA TV, booted via lxboot
 */

/dts-v1/;

/memreserve/ 0x0000000000000000 0x0000000000001000;

#include "lg1314.dtsi"

/ {
	model = "LG Electronics, DTV SoC LG1314 (AArch64)";
	compatible = "lge,lg1314", "lge,lg1k";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/* Reserved, fixed-size slots the boot firmware patches in place (no libfdt).
		 * bootargs: 256 bytes (255 chars + NUL). initrd addrs: 8 bytes each. */
		bootargs = "                                                                                                                                                                                                                                                               ";
		linux,initrd-start = <0x0 0x0>;
		linux,initrd-end = <0x0 0x0>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* OSD0 scanout left live by the boot firmware (linear, 1080p,
		 * upscaled to the panel). Inside kdrv_buffer1, so already no-map. */
		framebuffer@78602000 {
			compatible = "simple-framebuffer";
			reg = <0x78602000 0x7e9000>;
			width = <1920>;
			height = <1080>;
			stride = <7680>;
			format = "a8r8g8b8";
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x3e400000>,
		      <0x4f400000 0x30c00000>,
		      <0xaf000000 0x11000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * The DE firmware embeds absolute DDR pointers; its image and
		 * working buffers must sit at their expected base (0x50000000,
		 * spanning to ~0x554b0568). Reserve it fixed and keep scanout out.
		 */
		de_fw: de-fw@50000000 {
			reg = <0x50000000 0x06000000>;
			no-map;
		};

		/* Scanout DMA pool, clear of the DE firmware region. */
		display_pool: display-pool@56000000 {
			compatible = "shared-dma-pool";
			reg = <0x56000000 0x08000000>;
			no-map;
		};

		kdrv_buffer1@5e000000 {
			no-map;
			reg = <0x5e000000 0x22000000>;
		};

		kdrv_buffer2@af000000 {
			no-map;
			reg = <0xaf000000 0x11000000>;
		};
	};

	display: display-subsystem {
		compatible = "lge,lg1314-drm";
		memory-region = <&display_pool>, <&de_fw>;
		memory-region-names = "scanout", "de-fw";
		lge,micom = <&micom>;
	};
};

&micom_i2c {
	micom: micom@29 {
		compatible = "lge,lg1314-micom";
		reg = <0x29>;
	};
};

&emmc {
	lge,otap-del-sel-mmc-hs = <6>;
	lge,itap-del-sel-mmc-hs = <26>;
	lge,otap-del-sel-hs200 = <6>;
	lge,otap-del-sel-hs400 = <3>;
};
