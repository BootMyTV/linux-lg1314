// SPDX-License-Identifier: GPL-2.0
/*
 * Derived from a "LJ9 Chassis" board found in an LG OLED55B9PLA TV, booted via lxboot
 */

/dts-v1/;

/memreserve/ 0x0000000000000000 0x0000000000001000;

#include "lg1314.dtsi"

/ {
	model = "LG Electronics, DTV SoC LG1314 (AArch64)";
	compatible = "lge,lg1314", "lge,lg1k";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/* Reserved, fixed-size slots the boot firmware patches in place (no libfdt).
		 * bootargs: 256 bytes (255 chars + NUL). initrd addrs: 8 bytes each. */
		bootargs = "                                                                                                                                                                                                                                                               ";
		linux,initrd-start = <0x0 0x0>;
		linux,initrd-end = <0x0 0x0>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* OSD0 scanout left live by the boot firmware (linear, 1080p,
		 * upscaled to the panel). Inside kdrv_buffer1, so already no-map. */
		framebuffer@78602000 {
			compatible = "simple-framebuffer";
			reg = <0x78602000 0x7e9000>;
			width = <1920>;
			height = <1080>;
			stride = <7680>;
			format = "a8r8g8b8";
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x3e400000>,
		      <0x4f400000 0x30c00000>,
		      <0xaf000000 0x11000000>;
	};

	/*
	 * kdrv_buffer1 (0x4f400000-0x80000000) and kdrv_buffer2
	 * (0xaf000000-0xc0000000) are reserved whole, as by the stock firmware,
	 * and split into the stock platform's regions: the display and decode
	 * firmware are given (or assume) these addresses.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* Video decoder: decoded pictures. A CMA area (lent to Linux while
		 * unused) so the frames can be shared as dma-bufs. */
		vdec_dpb: vdec-dpb@4f400000 {
			compatible = "shared-dma-pool";
			reg = <0x4f400000 0x13c00000>;
			reusable;
		};

		/* Video decoder: stream buffers (24 MiB), then the decode
		 * coprocessor's own pool (IPC area, firmware image, ...). */
		vdec_mcu: vdec-mcu@63000000 {
			reg = <0x63000000 0x02c00000>;
			no-map;
		};

		/*
		 * Graphics surfaces: the scanout pool. CMA rather than a no-map
		 * coherent pool: that one rounds each buffer up to a power of
		 * two, so a 4K AFBC buffer (32 MiB + header) would take 64 MiB.
		 */
		gfx_surface: gfx-surface@65c00000 {
			compatible = "shared-dma-pool";
			reg = <0x65c00000 0x07c00000>;
			reusable;
		};

		kdrv-misc@6d800000 {
			reg = <0x6d800000 0x00b00000>;
			no-map;
		};

		/* Display engine: shared/working memory of its firmware. */
		de_fw_m0: de-fw-m0@6e300000 {
			reg = <0x6e300000 0x00100000>;
			no-map;
		};

		/* Display engine: pre-write + frame-rate-conversion buffers. */
		de_prew: de-prew@6e400000 {
			reg = <0x6e400000 0x08a00000>;
			no-map;
		};

		de_hdr: de-hdr@76e00000 {
			reg = <0x76e00000 0x00300000>;
			no-map;
		};

		/* Includes the boot firmware's live scanout (framebuffer@78602000). */
		kdrv-misc@77100000 {
			reg = <0x77100000 0x08f00000>;
			no-map;
		};

		/* Display engine firmware image. */
		de_fw: de-fw@af000000 {
			reg = <0xaf000000 0x00400000>;
			no-map;
		};

		/* Display engine: frame buffers. */
		de_frm: de-frm@af400000 {
			reg = <0xaf400000 0x09400000>;
			no-map;
		};

		/* Display engine: VTG buffers. */
		de_vt: de-vt@b8800000 {
			reg = <0xb8800000 0x02400000>;
			no-map;
		};

		/* Back end and other blocks' memory. */
		kdrv_be: kdrv-be@bac00000 {
			reg = <0xbac00000 0x05400000>;
			no-map;
		};
	};

	display: display-subsystem {
		compatible = "lge,lg1314-drm";
		memory-region = <&gfx_surface>, <&de_fw>, <&de_fw_m0>, <&de_prew>,
				<&de_hdr>, <&de_frm>, <&de_vt>, <&kdrv_be>,
				<&vdec_dpb>;
		memory-region-names = "scanout", "de-fw", "de-fw-m0", "de-prew",
				      "de-hdr", "de-frm", "de-vt", "be",
				      "vdec-dpb";
		/* Model word for the DE firmware (from the board's hwopt). */
		lge,de-model = <0x00020001>;
		lge,micom = <&micom>;
		lge,vdec = <&vdec>;
		/* OSD mixer vsync, DE sync pulses (video tick) */
		interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>;
	};

	vdec: vdec {
		compatible = "lge,lg1314-vdec";
		memory-region = <&vdec_mcu>, <&vdec_dpb>;
		memory-region-names = "mcu", "dpb";
		interrupts = <GIC_SPI 120 IRQ_TYPE_LEVEL_HIGH>;
	};
};

&micom_i2c {
	micom: micom@29 {
		compatible = "lge,lg1314-micom";
		reg = <0x29>;
	};
};

&emmc {
	lge,otap-del-sel-mmc-hs = <6>;
	lge,itap-del-sel-mmc-hs = <26>;
	lge,otap-del-sel-hs200 = <6>;
	lge,otap-del-sel-hs400 = <3>;
};
